{
  "$comment": "Copy corrections applied to visible text only (HTML text nodes, alt/title/aria-label/meta content, and the matching Storebox page-data strings) so server HTML and hydrated output stay identical. `match: \"phrase\"` is an exact case-sensitive substring; `match: \"word\"` is a whole-word, case-sensitive match. `exclude` lists route prefixes left untouched.",
  "rules": [
    { "group": "Service statement", "match": "phrase", "find": "Support before and during travel", "replace": "Support before, during and after travel." },
    { "group": "Availability wording", "match": "phrase", "find": "Live availability confirmed", "replace": "Availability subject to supplier confirmation" },

    { "group": "Agent bios", "match": "phrase", "find": "Europe and Africa I became a Travel Consultant", "replace": "I became a travel consultant" },
    { "group": "Agent bios", "match": "phrase", "find": "she asked me\"why don't you try this?\"", "replace": "she asked me, \"Why don't you try this?\"" },
    { "group": "Agent bios", "match": "phrase", "find": "memorable vacations , tailoring trips based on my clients personal tastes", "replace": "memorable vacations, tailoring trips based on my clients' personal tastes" },
    { "group": "Agent bios", "match": "phrase", "find": "Caribbean Islands Being a travel agent is so rewarding", "replace": "Being a travel agent is so rewarding" },
    { "group": "Agent names", "match": "phrase", "find": "JAMES MCPARLAND", "replace": "James McParland" },

    { "group": "Travel Journal titles", "match": "phrase", "find": "Aruba all inclusive resorts", "replace": "Aruba all-inclusive resorts" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Best all inclusive resorts in mexico", "replace": "Best all-inclusive resorts in Mexico" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Best mediterranean cruises", "replace": "Best Mediterranean cruises" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Family all inclusive resorts", "replace": "Family all-inclusive resorts" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Royal caribbean vs carnival cruise", "replace": "Royal Caribbean vs Carnival Cruise" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Bermuda vs bahamas", "replace": "Bermuda vs the Bahamas" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Viking vs amawaterways", "replace": "Viking vs AmaWaterways" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Best european river cruise lines", "replace": "Best European river cruise lines" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Best adults only all inclusive resorts", "replace": "Best adults-only all-inclusive resorts" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Cruises from new york", "replace": "Cruises from New York" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Best time to cruise caribbean", "replace": "Best time to cruise the Caribbean" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Best time to visit punta cana", "replace": "Best time to visit Punta Cana" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Best time to visit south pacific", "replace": "Best time to visit the South Pacific" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Caribbean vs mexico", "replace": "Caribbean vs Mexico" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Best time to visit cancun", "replace": "Best time to visit Cancun" },
    { "group": "Travel Journal titles", "match": "phrase", "find": "Best time to visit south korea", "replace": "Best time to visit South Korea" },

    { "group": "US spelling", "match": "word", "find": "travellers", "replace": "travelers", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "Travellers", "replace": "Travelers", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "traveller", "replace": "traveler", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "Traveller", "replace": "Traveler", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "travelling", "replace": "traveling", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "organised", "replace": "organized", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "organise", "replace": "organize", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "centre", "replace": "center", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "neighbourhoods", "replace": "neighborhoods", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "neighbourhood", "replace": "neighborhood", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "harbour", "replace": "harbor", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "programme", "replace": "program", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "personalised", "replace": "personalized", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "Personalised", "replace": "Personalized", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "favourite", "replace": "favorite", "exclude": ["/partners", "/privacy", "/terms"] },
    { "group": "US spelling", "match": "word", "find": "Enquire", "replace": "Inquire", "exclude": ["/partners", "/privacy", "/terms"] }
  ],
  "specialtyLabels": {
    "$comment": "Agent specialty chips on /team and profile pages, normalized to Title Case to match the majority style (e.g. \"River Cruises\").",
    "groups": "Groups",
    "family travel": "Family Travel",
    "cruises": "Cruises",
    "honeymoons throughout Europe": "Honeymoons Throughout Europe",
    "families": "Families",
    "honeymooners": "Honeymooners",
    "clients celebrating special occasions": "Special Occasions",
    "milestone anniversaries": "Milestone Anniversaries",
    "all‑inclusive vacations": "All-Inclusive Vacations",
    "All-Inclusive vacations": "All-Inclusive Vacations",
    "curated transformational travel experiences for families": "Transformational Family Travel",
    "solo travelers": "Solo Travelers",
    "the Caribbean": "The Caribbean",
    "Cruise planning": "Cruise Planning",
    "Custom vacations": "Custom Vacations",
    "Group travel": "Group Travel"
  }
}
